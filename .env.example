# Copy this file to .env and fill in your own GENERATION_API_KEY below.
# Never commit a .env with a real key in it -- .env is already gitignored,
# but double-check before committing if you ever rename or copy it.

# --- Which configuration to run -------------------------------------------
# "demo": synthetic sample-receipt corpus, safe for public deployment (default).
# "research": the real, evaluated 3,712-document corpus — for local use only,
#   never deploy this publicly (see PROGRESS.md for the licensing reason).
APP_CONFIG=demo

# --- Corpus / index paths ---------------------------------------------------
# Demo values shown; for APP_CONFIG=research, point these at data/chunks/chunks.jsonl
# and data/index/ instead (never commit a .env with research paths).
CHUNKS_PATH=demo_data/demo_chunks.jsonl
INDEX_DIR=demo_data/index

# --- Models -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
USE_RERANKER=true
# "cpu" for the local Docker demo -- the deployment image
# (requirements-deploy.txt, Dockerfile) installs CPU-only PyTorch
# regardless of this setting, so this just avoids depending on
# app/config.py's automatic CPU fallback when no GPU is present.
# Set to "cuda" instead only if you're running this app directly (not
# via Docker) on a machine with a working CUDA GPU.
DEVICE=cpu

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_POOL_SIZE=50
TOP_K=5

# --- Generation -------------------------------------------------------------
# This app talks to any OpenAI-compatible chat-completions endpoint. The
# local demo is configured for Together.ai's hosted Qwen3.5-9B by default
# below -- you need your own Together.ai account and API key (a small
# prepaid balance; see together.ai for current pricing). Get a key at
# https://api.together.ai/settings/api-keys, then set GENERATION_API_KEY
# to it below. Never commit a real key -- this file only ever holds a
# placeholder.
#
# The OLLAMA_* variable names below are historical: this provider was
# originally built against local Ollama, and the same OpenAI-compatible
# client code works unchanged against Together.ai -- only these three
# values change, not any code. GENERATION_PROVIDER=ollama is also just
# the (generically-named) provider class this app uses internally for
# any OpenAI-compatible endpoint; it is not specific to the Ollama
# project itself.
GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=https://api.together.ai/v1
OLLAMA_MODEL=Qwen/Qwen3.5-9B
GENERATION_API_KEY=your-together-ai-api-key-here
GENERATION_TIMEOUT_S=60

# --- API --------------------------------------------------------------
MAX_QUESTION_LENGTH=500

# --- Practical deployment limits (Milestone 5) -----------------------------
# Simple, single-process, in-memory limits -- see app/ratelimit.py.
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5
MAX_CONCURRENT_HEAVY_REQUESTS=3

# --- Upload mode (user-supplied receipts) ----------------------------------
# Stored outside the repo entirely — never committed, never logged in full.
UPLOAD_DIR=/tmp/doc-rag-uploads
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_PDF_PAGES=20
UPLOAD_PROCESSING_TIMEOUT_S=45
UPLOAD_SESSION_TTL_MINUTES=30
UPLOAD_EMBEDDING_DEVICE=cpu
UPLOAD_MAX_FILES_PER_SESSION=10
