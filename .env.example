# Copy this file to .env and adjust as needed. No secrets belong in either
# file — the only "credential" this app currently uses is a local Ollama
# endpoint, which needs no API key.

# --- Which configuration to run -------------------------------------------
# "demo": synthetic sample-receipt corpus, safe for public deployment (default).
# "research": the real, evaluated 3,712-document corpus — for local use only,
#   never deploy this publicly (see PROGRESS.md for the licensing reason).
APP_CONFIG=demo

# --- Corpus / index paths ---------------------------------------------------
# Demo values shown; for APP_CONFIG=research, point these at data/chunks/chunks.jsonl
# and data/index/ instead (never commit a .env with research paths).
CHUNKS_PATH=demo_data/demo_chunks.jsonl
INDEX_DIR=demo_data/index

# --- Models -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
USE_RERANKER=true
# "cuda" is this project's local dev default; the deployment image
# (requirements-deploy.txt, Dockerfile) installs CPU-only PyTorch, so a
# deployed container should set this to "cpu" (or leave it as "cuda" --
# app/config.py's comment notes CUDA code already falls back to CPU
# automatically when no GPU is present, but setting it explicitly avoids
# depending on that fallback).
DEVICE=cuda

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_POOL_SIZE=50
TOP_K=5

# --- Generation -----------------------------------------------------------
# IMPORTANT for deployment: "localhost" only works when Ollama runs on the
# SAME machine as this app. A deployed container cannot reach a laptop's
# Ollama instance -- point this at wherever the LLM is actually hosted
# (a self-hosted Ollama instance's real address, or a hosted inference
# provider's OpenAI-compatible endpoint) before deploying. See PROGRESS.md's
# Milestone 5 section for the current recommendation and cost comparison.
GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
GENERATION_TIMEOUT_S=60

# --- API --------------------------------------------------------------
MAX_QUESTION_LENGTH=500

# --- Practical deployment limits (Milestone 5) -----------------------------
# Simple, single-process, in-memory limits -- see app/ratelimit.py.
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5
MAX_CONCURRENT_HEAVY_REQUESTS=3

# --- Upload mode (user-supplied receipts) ----------------------------------
# Stored outside the repo entirely — never committed, never logged in full.
UPLOAD_DIR=/tmp/doc-rag-uploads
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_PDF_PAGES=20
UPLOAD_PROCESSING_TIMEOUT_S=45
UPLOAD_SESSION_TTL_MINUTES=30
UPLOAD_EMBEDDING_DEVICE=cpu
UPLOAD_MAX_FILES_PER_SESSION=10
